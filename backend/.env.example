# ── App ──────────────────────────────────────────────────────────────────────
PROJECT_NAME=Smart Travel Planner API
VERSION=0.2.0
API_PREFIX=/api/v1
DEBUG=True
PORT=8000

# ── Database (Supabase / local Docker) ───────────────────────────────────────
# Supabase example:
#   postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@db:5432/app

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-64-char-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ── CORS (comma-separated) ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── External APIs (free tiers) ───────────────────────────────────────────────
OPENWEATHER_API_KEY=
EXCHANGERATE_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── AI providers (set at least one key — fallback in priority order) ─────────
# Comma-separated priority order. First with a key configured is used; on
# failure the next is tried. Valid: gemini, groq, openrouter.
AI_PROVIDERS=groq,openrouter,gemini

# Google Gemini — https://aistudio.google.com (free tier instável: 50 req/dia)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq — https://console.groq.com (free tier ~14k req/dia, mais rápido do mercado)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — https://openrouter.ai (modelos `:free` ilimitados)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free