# ── Backend ───────────────────────────────────────────────────────────────────
# Em Docker deixe vazio (nginx proxia /api/ para o backend).
# Em desenvolvimento local use http://localhost:8000
VITE_API_BASE_URL=

# Ativa integração com o backend real (desabilita mocks)
VITE_USE_BACKEND=true

# ── Auth mock (desenvolvimento sem backend) ───────────────────────────────────
# "true" → login/registro falso em memória, sem backend.
# Deve ser "false" em produção.
VITE_MOCK_AUTH=false

# ── APIs externas (só necessárias quando VITE_USE_BACKEND=false) ──────────────
# Em produção (VITE_USE_BACKEND=true) essas chamadas são feitas pelo backend.
VITE_OPENWEATHER_API_KEY=
VITE_UNSPLASH_ACCESS_KEY=
VITE_EXCHANGERATE_API_KEY=
